rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidConversationShape() {
      let data = request.resource.data;
      return data.keys().hasOnly(['updatedAt', 'lastMessage'])
        && data.keys().hasAll(['updatedAt', 'lastMessage'])
        && data.updatedAt is timestamp
        && data.lastMessage is string
        && data.lastMessage.size() > 0
        && data.lastMessage.size() <= 4000;
    }

    function hasValidConversationMessageShape() {
      let data = request.resource.data;
      return data.keys().hasOnly(['role', 'text', 'createdAt'])
        && data.keys().hasAll(['role', 'text', 'createdAt'])
        && data.role in ['user', 'assistant']
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 4000
        && data.createdAt is timestamp;
    }

    function hasValidMemoryReplacementActionShape(actionId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'actionId', 'actionType',
          'accountScopeFingerprint', 'existingMemoryId', 'proposedMemoryId',
          'canonicalKey', 'expectedExistingRevision',
          'expectedProposedRevision', 'contradictionId', 'reasonCode', 'state',
          'logicalRequestFingerprint', 'createdAt', 'updatedAt', 'executedAt',
          'executionCode', 'finalExistingRevision', 'finalProposedRevision',
          'contradictionCandidate'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'actionId', 'actionType',
          'accountScopeFingerprint', 'existingMemoryId', 'proposedMemoryId',
          'canonicalKey', 'expectedExistingRevision',
          'expectedProposedRevision', 'contradictionId', 'reasonCode', 'state',
          'logicalRequestFingerprint', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.actionId == actionId
        && data.actionId is string
        && data.actionId.size() == 64
        && data.actionType == 'memoryReplacementConfirmation'
        && data.accountScopeFingerprint is string
        && data.accountScopeFingerprint.size() == 64
        && data.existingMemoryId is string
        && data.existingMemoryId.size() > 0
        && data.existingMemoryId.size() <= 200
        && data.proposedMemoryId is string
        && data.proposedMemoryId.size() > 0
        && data.proposedMemoryId.size() <= 200
        && data.proposedMemoryId != data.existingMemoryId
        && data.canonicalKey is string
        && data.canonicalKey.size() > 3
        && data.canonicalKey.size() <= 500
        && data.expectedExistingRevision is int
        && data.expectedExistingRevision > 0
        && data.expectedProposedRevision is int
        && data.expectedProposedRevision > 0
        && data.contradictionId is string
        && data.contradictionId.size() == 64
        && data.reasonCode is string
        && data.reasonCode.size() > 0
        && data.reasonCode.size() <= 100
        && data.state in [
          'pending', 'declined', 'cancelled', 'acceptedPendingExecution',
          'executed', 'conflict'
        ]
        && data.logicalRequestFingerprint is string
        && data.logicalRequestFingerprint.size() == 64
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        && (!data.keys().hasAny(['executedAt'])
          || (data.executedAt is string && data.executedAt.size() <= 40))
        && (!data.keys().hasAny(['executionCode'])
          || (data.executionCode is string && data.executionCode.size() <= 100))
        && (!data.keys().hasAny(['finalExistingRevision'])
          || (data.finalExistingRevision is int
            && data.finalExistingRevision > 0))
        && (!data.keys().hasAny(['finalProposedRevision'])
          || (data.finalProposedRevision is int
            && data.finalProposedRevision > 0))
        && (!data.keys().hasAny(['contradictionCandidate'])
          || (data.contradictionCandidate is map
            && data.contradictionCandidate.size() <= 16));
    }

    function hasValidIdentityShape(entityId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id', 'type', 'canonicalLabel', 'normalizedLabel', 'aliases',
          'aliasComparisonKeys', 'status', 'source', 'createdAt', 'updatedAt',
          'metadata', 'schemaVersion', 'revision'
        ])
        && data.keys().hasAll([
          'id', 'type', 'canonicalLabel', 'normalizedLabel', 'aliases',
          'aliasComparisonKeys', 'status', 'source', 'createdAt', 'updatedAt',
          'metadata', 'schemaVersion', 'revision'
        ])
        && data.id == entityId
        && data.id is string
        && data.type in [
          'person', 'place', 'organization', 'household', 'group', 'activity',
          'vehicle', 'pet', 'product'
        ]
        && data.canonicalLabel is string
        && data.canonicalLabel.size() > 0
        && data.canonicalLabel.size() <= 200
        && data.normalizedLabel is string
        && data.normalizedLabel.size() > 0
        && data.normalizedLabel.size() <= 200
        && data.aliases is list
        && data.aliases.size() <= 20
        && data.aliasComparisonKeys is list
        && data.aliasComparisonKeys.size() <= 20
        && data.source is map
        && data.metadata is map
        && data.createdAt is string
        && data.updatedAt is string
        && data.schemaVersion == 1
        && data.revision is int
        && data.revision > 0;
    }

    function isValidIdentityCreate(entityId) {
      return hasValidIdentityShape(entityId)
        && request.resource.data.status in ['active', 'inactive']
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.resource.data.updatedAt;
    }

    function isValidIdentityUpdate(entityId) {
      let next = request.resource.data;
      let previous = resource.data;
      return hasValidIdentityShape(entityId)
        && previous.status in ['active', 'inactive']
        && next.status in ['active', 'inactive', 'deleted']
        && next.id == previous.id
        && next.type == previous.type
        && next.createdAt == previous.createdAt
        && next.schemaVersion == previous.schemaVersion
        && next.revision == previous.revision + 1
        && next.updatedAt != previous.updatedAt;
    }

    function hasValidEventParticipantIdentity(userId) {
      let data = request.resource.data;
      let hasLink = data.keys().hasAny(['participantIdentity']);
      let link = hasLink ? data.participantIdentity : {};
      return !hasLink || (
        link is map
        && link.keys().hasOnly([
          'entityId', 'entityType', 'schemaVersion', 'role', 'accountScopeId'
        ])
        && link.keys().hasAll([
          'entityId', 'entityType', 'schemaVersion', 'role', 'accountScopeId'
        ])
        && link.entityId is string
        && link.entityId.size() > 0
        && link.entityId.size() <= 200
        && link.entityType == 'person'
        && link.schemaVersion == 1
        && link.role == 'participant'
        && link.accountScopeId is string
        && link.accountScopeId.size() > 0
        && link.accountScopeId.size() <= 128
        && link.accountScopeId == userId
      );
    }

    function eventParticipantRevision(data) {
      return data.keys().hasAny(['participantIdentityRevision'])
        ? data.participantIdentityRevision
        : (data.keys().hasAny(['participantIdentity']) ? 1 : 0);
    }

    function eventRevision(data) {
      return data.keys().hasAny(['eventRevision']) ? data.eventRevision : 0;
    }

    function hasValidEventParticipantLifecycle(userId) {
      let data = request.resource.data;
      let hasLink = data.keys().hasAny(['participantIdentity']);
      let hasRevision = data.keys().hasAny(['participantIdentityRevision']);
      let revision = eventParticipantRevision(data);
      return hasValidEventParticipantIdentity(userId)
        && revision is int
        && revision >= 0
        && (
          (hasLink && revision >= 1)
          || (!hasLink && (!hasRevision || revision == 0 || revision >= 2))
        );
    }

    function isValidEventCreate(userId) {
      let data = request.resource.data;
      let hasLink = data.keys().hasAny(['participantIdentity']);
      let revision = eventParticipantRevision(data);
      return hasValidEventParticipantLifecycle(userId)
        && eventRevision(data) is int
        && eventRevision(data) == 1
        && ((hasLink && revision == 1) || (!hasLink && revision == 0));
    }

    function isValidEventUpdate(userId) {
      let previousRevision = eventParticipantRevision(resource.data);
      let nextRevision = eventParticipantRevision(request.resource.data);
      let previousLink = resource.data.keys().hasAny(['participantIdentity'])
        ? resource.data.participantIdentity
        : null;
      let nextLink = request.resource.data.keys().hasAny(['participantIdentity'])
        ? request.resource.data.participantIdentity
        : null;
      let previousEventRevision = eventRevision(resource.data);
      let nextEventRevision = eventRevision(request.resource.data);
      return hasValidEventParticipantLifecycle(userId)
        && nextEventRevision is int
        && nextEventRevision == previousEventRevision + 1
        && (
          (nextLink == previousLink && nextRevision == previousRevision)
          || (nextLink != previousLink && nextRevision == previousRevision + 1)
        );
    }

    function hasValidHumanModelShape(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'modelRevision', 'accountScopeId', 'payload',
          'createdAt', 'updatedAt', 'lastMutationId', 'migrationVersion',
          'migrationStatus', 'creationSource'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'modelRevision', 'accountScopeId', 'payload',
          'createdAt', 'updatedAt', 'lastMutationId', 'migrationVersion',
          'migrationStatus', 'creationSource'
        ])
        && data.schemaVersion == 1
        && data.modelRevision is int
        && data.modelRevision > 0
        && data.accountScopeId == userId
        && data.payload is map
        && data.payload.keys().hasAll([
          'schemaVersion', 'accountScopeId', 'primaryPersonId', 'persons',
          'relationships', 'households', 'residences', 'memberships',
          'responsibilities', 'legacyProfile'
        ])
        && data.payload.schemaVersion == data.schemaVersion
        && data.payload.accountScopeId == userId
        && data.payload.primaryPersonId is string
        && data.payload.primaryPersonId.size() > 0
        && data.payload.persons is list
        && data.payload.persons.size() > 0
        && data.payload.relationships is list
        && data.payload.households is list
        && data.payload.residences is list
        && data.payload.memberships is list
        && data.payload.responsibilities is list
        && data.payload.legacyProfile is map
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 128
        && data.migrationVersion == 1
        && data.migrationStatus == 'complete'
        && data.creationSource in [
          'legacyOrLocalMigration', 'canonicalRestore', 'canonicalMutation'
        ];
    }

    function isValidHumanModelCreate(userId) {
      let data = request.resource.data;
      return hasValidHumanModelShape(userId)
        && data.modelRevision == 1
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidHumanModelUpdate(userId) {
      let next = request.resource.data;
      let previous = resource.data;
      return hasValidHumanModelShape(userId)
        && next.accountScopeId == previous.accountScopeId
        && next.schemaVersion == previous.schemaVersion
        && next.createdAt == previous.createdAt
        && next.modelRevision == previous.modelRevision + 1
        && next.lastMutationId != previous.lastMutationId
        && next.updatedAt == request.time;
    }

    function hasValidRevisionedEntity(userId, entityId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'accountScopeId', 'entityId', 'payload', 'revision',
          'createdAt', 'updatedAt', 'lastMutationId', 'syncStatus',
          'isTombstone', 'clearGeneration'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'accountScopeId', 'entityId', 'payload', 'revision',
          'createdAt', 'updatedAt', 'lastMutationId', 'syncStatus',
          'isTombstone'
        ])
        && data.schemaVersion == 1
        && data.accountScopeId == userId
        && data.entityId == entityId
        && data.entityId is string
        && data.entityId.size() > 0
        && data.entityId.size() <= 200
        && data.payload is map
        && data.payload.size() <= 32
        && data.revision is int
        && data.revision > 0
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 128
        && data.syncStatus == 'synced'
        && data.isTombstone is bool
        && (!data.keys().hasAny(['clearGeneration'])
          || (data.clearGeneration is int && data.clearGeneration >= 0));
    }

    function isValidRevisionedCreate(userId, entityId) {
      return hasValidRevisionedEntity(userId, entityId)
        && request.resource.data.revision == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidRevisionedUpdate(userId, entityId) {
      let next = request.resource.data;
      let previous = resource.data;
      return hasValidRevisionedEntity(userId, entityId)
        && next.accountScopeId == previous.accountScopeId
        && next.entityId == previous.entityId
        && next.schemaVersion == previous.schemaVersion
        && next.createdAt == previous.createdAt
        && next.revision == previous.revision + 1
        && next.lastMutationId != previous.lastMutationId
        && (!previous.isTombstone || next.isTombstone)
        && next.updatedAt == request.time;
    }

    function hasValidRevisionedProfile(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'accountScopeId', 'entityId', 'payload',
          'profileRevision', 'createdAt', 'updatedAt', 'lastMutationId',
          'syncStatus', 'legacyExtensions', 'projectionProvenance'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'accountScopeId', 'entityId', 'payload',
          'profileRevision', 'createdAt', 'updatedAt', 'lastMutationId',
          'syncStatus', 'legacyExtensions', 'projectionProvenance'
        ])
        && data.schemaVersion == 1
        && data.accountScopeId == userId
        && data.entityId == 'profile'
        && data.payload is map
        && data.payload.size() <= 40
        && !data.payload.keys().hasAny([
          'humanPersonId', 'partnerHumanPersonId', 'firstName', 'familyStatus',
          'partnerName', 'children', 'age', 'birthDate', 'partnerBirthDate',
          'relationshipStatus', 'marriageDate', 'engagementDate'
        ])
        && data.profileRevision is int
        && data.profileRevision > 0
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 128
        && data.syncStatus == 'synced'
        && data.legacyExtensions is map
        && data.legacyExtensions.size() <= 64
        && data.projectionProvenance in ['profileOwned', 'legacyCloud'];
    }

    function hasValidActionLedger(userId, ledgerEntryId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'ledgerEntryId', 'accountScopeId', 'actionType',
          'actionDomain', 'actionOrigin', 'riskLevel', 'policyModeObserved',
          'policyVersionObserved', 'sessionGeneration', 'requestId',
          'pendingActionId', 'mutationId', 'targetReference',
          'expectedRevision', 'resultRevision', 'status', 'outcome',
          'createdAt', 'authorizedAt', 'dispatchedAt', 'completedAt',
          'updatedAt', 'undoCapability', 'parentLedgerEntryId',
          'causationLedgerEntryId', 'correlationId', 'provenance',
          'errorCode', 'ledgerRevision', 'lastMutationId', 'inversePatch'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'ledgerEntryId', 'accountScopeId', 'actionType',
          'actionDomain', 'actionOrigin', 'riskLevel', 'policyModeObserved',
          'policyVersionObserved', 'mutationId', 'targetReference',
          'expectedRevision', 'status', 'outcome', 'createdAt', 'updatedAt',
          'undoCapability', 'correlationId', 'provenance', 'ledgerRevision',
          'lastMutationId'
        ])
        && data.schemaVersion == 1
        && data.ledgerEntryId == ledgerEntryId
        && data.accountScopeId == userId
        && data.ledgerEntryId is string
        && data.ledgerEntryId.size() > 0
        && data.ledgerEntryId.size() <= 200
        && data.mutationId is string
        && data.mutationId.size() > 0
        && data.mutationId.size() <= 200
        && data.targetReference is map
        && data.targetReference.size() <= 11
        && data.undoCapability is map
        && data.undoCapability.size() <= 8
        && (!data.keys().hasAny(['inversePatch'])
          || (data.inversePatch is map
            && data.inversePatch.keys().hasOnly([
              'type', 'entries', 'title', 'category', 'isDone', 'createdAt',
              'isImportant', 'dueDate', 'notes', 'planning', 'priority',
              'wasTombstone', 'isBought', 'isUrgent', 'section',
              'clearGeneration', 'text', 'normalizedText',
              'lifecycleStatus', 'confirmationStatus', 'isHealth'
            ])
            && data.inversePatch.type in ['task', 'shopping', 'profile', 'memory']
            && (!data.inversePatch.keys().hasAny(['entries'])
              || (data.inversePatch.entries is list
                && data.inversePatch.entries.size() <= 32))))
        && data.expectedRevision is int
        && data.expectedRevision >= 0
        && data.ledgerRevision is int
        && data.ledgerRevision > 0
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 200
        && data.status in [
          'proposed', 'awaitingConfirmation', 'authorized', 'dispatching',
          'pendingSync', 'succeeded', 'failed', 'conflict',
          'blockedByPolicy', 'cancelled', 'expired', 'undoAvailable',
          'undoRequested', 'undoDispatching', 'undone', 'undoPendingSync',
          'undoConflict', 'undoFailed', 'notUndoable'
        ]
        && data.outcome in [
          'completed', 'pendingSync', 'rejected', 'conflict',
          'validationFailure', 'policyBlocked', 'cancelled', 'unknownResult',
          'technicalFailure'
        ];
    }

    function validActionLedgerTransition(previous, next) {
      return
        (previous.status == 'proposed'
          && next.status in ['awaitingConfirmation', 'authorized',
            'blockedByPolicy', 'cancelled', 'expired'])
        || (previous.status == 'awaitingConfirmation'
          && next.status in ['authorized', 'blockedByPolicy', 'cancelled',
            'expired'])
        || (previous.status == 'authorized'
          && next.status in ['dispatching', 'blockedByPolicy', 'cancelled'])
        || (previous.status == 'dispatching'
          && next.status in ['pendingSync', 'succeeded', 'failed', 'conflict'])
        || (previous.status == 'pendingSync'
          && next.status in ['succeeded', 'failed', 'conflict'])
        || (previous.status == 'succeeded'
          && next.status in ['undoAvailable', 'notUndoable'])
        || (previous.status == 'undoAvailable'
          && next.status in ['undoRequested', 'expired'])
        || (previous.status == 'undoRequested'
          && next.status in ['undoDispatching', 'blockedByPolicy',
            'undoConflict', 'undoFailed'])
        || (previous.status == 'undoDispatching'
          && next.status in ['undone', 'undoPendingSync', 'undoConflict',
            'undoFailed'])
        || (previous.status == 'undoPendingSync'
          && next.status in ['undone', 'undoConflict', 'undoFailed']);
    }

    function hasValidMemoryPolicyShape(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'accountScopeId', 'generalMode', 'healthMode',
          'healthConsentGranted', 'changedAt', 'changeSource',
          'policyRevision', 'createdAt', 'updatedAt',
          'explicitHealthConsentAt', 'lastMutationId'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'accountScopeId', 'generalMode', 'healthMode',
          'healthConsentGranted', 'changedAt', 'changeSource',
          'policyRevision', 'createdAt', 'updatedAt', 'lastMutationId'
        ])
        && data.schemaVersion == 1
        && data.accountScopeId == userId
        && data.generalMode in ['automatic', 'askEveryTime', 'paused']
        && data.healthMode in ['disabled', 'askEveryTime', 'enabled']
        && data.healthConsentGranted is bool
        && (data.healthMode != 'enabled' || data.healthConsentGranted == true)
        && (data.healthMode != 'enabled'
          || (data.keys().hasAny(['explicitHealthConsentAt'])
            && data.explicitHealthConsentAt is timestamp))
        && (!data.keys().hasAny(['explicitHealthConsentAt'])
          || data.explicitHealthConsentAt is timestamp)
        && data.changeSource in ['explicitUserSetting', 'restrictiveDefault']
        && data.changedAt is timestamp
        && data.policyRevision is int
        && data.policyRevision > 0
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 128;
    }

    function isValidMemoryShape(userId, memoryId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'memoryId', 'accountScopeId', 'memoryRevision',
          'lifecycleStatus', 'confirmationStatus', 'provenance',
          'sensitivity', 'category', 'isHealth', 'text', 'normalizedText',
          'createdAt', 'updatedAt', 'validFrom', 'validUntil', 'expiresAt',
          'structuredDomain', 'structuredReferenceId', 'lastMutationId',
          'tombstone', 'semanticType', 'importance', 'lifecycleState',
          'confirmedAt', 'rejectedAt', 'deletedAt', 'replacedByMemoryId',
          'supersededByMemoryId', 'supersedesMemoryId', 'lifecycleHistory',
          'history',
          'evidenceClassification', 'evidenceSubjectType', 'evidenceRisks',
          'isCorrection', 'subjectEntityId', 'semanticIdentity',
          'canonicalKey', 'semanticValue',
          'eligibleForAutomaticContradiction', 'logicalRequestFingerprint',
          'contradictionId', 'replacementActionId'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'memoryId', 'accountScopeId', 'memoryRevision',
          'lifecycleStatus', 'confirmationStatus', 'provenance',
          'sensitivity', 'category', 'isHealth', 'text', 'normalizedText',
          'createdAt', 'updatedAt', 'lastMutationId', 'tombstone'
        ])
        && data.schemaVersion == 1
        && data.memoryId == memoryId
        && data.accountScopeId == userId
        && data.memoryRevision is int
        && data.memoryRevision > 0
        && data.lifecycleStatus in [
          'proposed', 'confirmed', 'rejected', 'active', 'superseded',
          'obsolete', 'archived', 'deleted', 'expired'
        ]
        && data.confirmationStatus in [
          'unconfirmed', 'confirmed', 'inferred', 'rejected', 'obsolete'
        ]
        && data.provenance in [
          'profile', 'memory', 'event', 'routine', 'currentInstruction',
          'derived'
        ]
        && data.sensitivity in ['standard', 'sensitive']
        && data.category is string
        && data.category.size() <= 100
        && data.isHealth is bool
        && (!data.isHealth || data.sensitivity == 'sensitive')
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 4000
        && data.normalizedText is string
        && data.normalizedText.size() > 0
        && data.normalizedText.size() <= 4000
        && (!data.keys().hasAny(['validFrom']) || data.validFrom is timestamp)
        && (!data.keys().hasAny(['validUntil']) || data.validUntil is timestamp)
        && (!data.keys().hasAny(['expiresAt']) || data.expiresAt is timestamp)
        && (!data.keys().hasAny(['confirmedAt']) || data.confirmedAt is timestamp)
        && (!data.keys().hasAny(['rejectedAt']) || data.rejectedAt is timestamp)
        && (!data.keys().hasAny(['deletedAt']) || data.deletedAt is timestamp)
        && (!data.keys().hasAny(['semanticType'])
          || data.semanticType in [
            'fact', 'preference', 'routine', 'constraint', 'goal',
            'decision', 'temporary', 'relationship', 'unknown'
          ])
        && (!data.keys().hasAny(['importance'])
          || (data.importance is int
            && data.importance >= 0
            && data.importance <= 5))
        && (!data.keys().hasAny(['lifecycleHistory'])
          || (data.lifecycleHistory is list
            && data.lifecycleHistory.size() <= 100))
        && (!data.keys().hasAny(['history'])
          || (data.history is list && data.history.size() <= 50))
        && (!data.keys().hasAny(['evidenceClassification'])
          || data.evidenceClassification in [
            'directExplicit', 'ambiguous', 'hypothetical', 'conditional',
            'quoted', 'thirdParty', 'pastState', 'temporary', 'correction',
            'question', 'negated', 'unknown'
          ])
        && (!data.keys().hasAny(['evidenceSubjectType'])
          || data.evidenceSubjectType in [
            'user', 'structuredEntity', 'unresolvedThirdParty', 'unknown'
          ])
        && (!data.keys().hasAny(['evidenceRisks'])
          || (data.evidenceRisks is list
            && data.evidenceRisks.size() <= 10))
        && (!data.keys().hasAny(['isCorrection'])
          || data.isCorrection is bool)
        && (!data.keys().hasAny(['subjectEntityId'])
          || (data.subjectEntityId is string
            && data.subjectEntityId.size() > 0
            && data.subjectEntityId.size() <= 200))
        && (!data.keys().hasAny(['semanticIdentity'])
          || (data.semanticIdentity is map
            && data.semanticIdentity.schemaVersion == 1
            && data.semanticIdentity.domain is string
            && data.semanticIdentity.attribute is string
            && data.semanticIdentity.subjectScope is string
            && data.semanticIdentity.contextType is string
            && data.semanticIdentity.canonicalKey is string
            && data.semanticIdentity.canonicalKey.size() > 0
            && data.semanticIdentity.canonicalKey.size() <= 240
            && data.semanticIdentity.eligibleForAutomaticContradiction is bool))
        && (!data.keys().hasAny(['canonicalKey'])
          || (data.canonicalKey is string
            && data.canonicalKey.size() > 0
            && data.canonicalKey.size() <= 240))
        && (!data.keys().hasAny(['semanticValue'])
          || data.semanticValue == null
          || (data.semanticValue is string
            && data.semanticValue.size() <= 4000))
        && (!data.keys().hasAny(['eligibleForAutomaticContradiction'])
          || data.eligibleForAutomaticContradiction is bool)
        && (!data.keys().hasAny(['logicalRequestFingerprint'])
          || (data.logicalRequestFingerprint is string
            && data.logicalRequestFingerprint.size() == 64))
        && (!data.keys().hasAny(['contradictionId'])
          || (data.contradictionId is string
            && data.contradictionId.size() == 64))
        && (!data.keys().hasAny(['replacementActionId'])
          || (data.replacementActionId is string
            && data.replacementActionId.size() == 64))
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 128
        && data.tombstone is bool;
    }

    function isValidRoutineTime(value) {
      return value is string
        && value.matches('^(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]$');
    }

    function isValidRoutineDate(value) {
      return value is string
        && (
          value.matches(
            '^(19|20|21)[0-9][0-9]-('
            + '(01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])'
            + '|(04|06|09|11)-(0[1-9]|[12][0-9]|30)'
            + '|02-(0[1-9]|1[0-9]|2[0-8]))$'
          )
          || value.matches(
            '^((19|21)(0[48]|[2468][048]|[13579][26])'
            + '|20(00|0[48]|[2468][048]|[13579][26]))-02-29$'
          )
        );
    }

    function hasValidRoutineDays(data) {
      return data.days is list
        && data.days.size() <= 7
        && data.days.hasOnly([1, 2, 3, 4, 5, 6, 7]);
    }

    function hasValidOptionalRoutineReferences(data) {
      return (data.humanPersonId == null
          || (data.humanPersonId is string
            && data.humanPersonId.size() > 0
            && data.humanPersonId.size() <= 200))
        && (data.locationEntityId == null
          || (data.locationEntityId is string
            && data.locationEntityId.size() > 0
            && data.locationEntityId.size() <= 200));
    }

    function hasCompatiblePartialRoutineRecurrence(data) {
      return (data.recurrenceType == null
          && data.anchorDateIso == null
          && data.weekOfMonth == null)
        || (data.recurrenceType == 'weekly'
          && data.anchorDateIso == null
          && data.weekOfMonth == null)
        || (data.recurrenceType == 'weekdays'
          && data.days.size() == 0
          && data.anchorDateIso == null
          && data.weekOfMonth == null)
        || (data.recurrenceType == 'biweekly'
          && data.weekOfMonth == null
          && (data.anchorDateIso == null
            || isValidRoutineDate(data.anchorDateIso)))
        || (data.recurrenceType == 'monthlyNthWeekday'
          && data.days.size() <= 1
          && data.anchorDateIso == null
          && (data.weekOfMonth == null
            || data.weekOfMonth in [-1, 1, 2, 3, 4, 5]));
    }

    function hasCompleteRoutinePayload(data) {
      return data.keys().hasAll([
          'title', 'recurrenceType', 'days', 'startTime', 'durationMinutes',
          'travelGoMinutes', 'travelBackMinutes', 'marginMinutes'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 300
        && isValidRoutineTime(data.startTime)
        && data.durationMinutes is int
        && data.durationMinutes > 0
        && data.durationMinutes <= 10080
        && (
          (data.recurrenceType == 'weekly'
            && data.days.size() > 0
            && data.anchorDateIso == null
            && data.weekOfMonth == null)
          || (data.recurrenceType == 'weekdays'
            && data.days.size() == 0
            && data.anchorDateIso == null
            && data.weekOfMonth == null)
          || (data.recurrenceType == 'biweekly'
            && data.days.size() > 0
            && isValidRoutineDate(data.anchorDateIso)
            && data.weekOfMonth == null)
          || (data.recurrenceType == 'monthlyNthWeekday'
            && data.days.size() == 1
            && data.weekOfMonth in [-1, 1, 2, 3, 4, 5]
            && data.anchorDateIso == null)
        );
    }

    function hasValidRoutineScalarFields(data) {
      return hasValidRoutineDays(data)
        && data.travelGoMinutes is int
        && data.travelGoMinutes >= 0
        && data.travelGoMinutes <= 1440
        && data.travelBackMinutes is int
        && data.travelBackMinutes >= 0
        && data.travelBackMinutes <= 1440
        && data.marginMinutes is int
        && data.marginMinutes >= 0
        && data.marginMinutes <= 1440
        && (data.title == null
          || (data.title is string
            && data.title.size() > 0
            && data.title.size() <= 300))
        && (data.recurrenceType == null
          || data.recurrenceType in [
            'weekly', 'weekdays', 'biweekly', 'monthlyNthWeekday'
          ])
        && (data.startTime == null || isValidRoutineTime(data.startTime))
        && (data.durationMinutes == null
          || (data.durationMinutes is int
            && data.durationMinutes > 0
            && data.durationMinutes <= 10080))
        && (data.anchorDateIso == null
          || isValidRoutineDate(data.anchorDateIso))
        && (data.weekOfMonth == null
          || data.weekOfMonth in [-1, 1, 2, 3, 4, 5])
        && hasValidOptionalRoutineReferences(data)
        && hasCompatiblePartialRoutineRecurrence(data);
    }

    function hasValidRoutineShape(userId, routineId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'id', 'proposalId', 'accountScopeId',
          'logicalRequestId', 'title', 'humanPersonId', 'recurrenceType',
          'days', 'startTime', 'durationMinutes', 'anchorDateIso',
          'weekOfMonth', 'travelGoMinutes', 'travelBackMinutes',
          'marginMinutes', 'locationEntityId', 'status', 'createdAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'id', 'proposalId', 'accountScopeId',
          'logicalRequestId', 'title', 'recurrenceType', 'days', 'startTime',
          'durationMinutes', 'humanPersonId', 'anchorDateIso', 'weekOfMonth',
          'travelGoMinutes', 'travelBackMinutes', 'marginMinutes',
          'locationEntityId', 'status', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.id == routineId
        && data.proposalId == routineId
        && data.id is string
        && data.id.size() == 64
        && data.accountScopeId == userId
        && data.logicalRequestId is string
        && data.logicalRequestId.size() > 0
        && data.logicalRequestId.size() <= 200
        && data.status == 'active'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && hasValidRoutineScalarFields(data)
        && hasCompleteRoutinePayload(data);
    }

    function hasValidRoutineProposalShape(userId, proposalId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'proposalId', 'logicalRequestId', 'accountScopeId',
          'state', 'title', 'humanPersonId', 'recurrenceType', 'days',
          'startTime', 'durationMinutes', 'anchorDateIso', 'weekOfMonth',
          'travelGoMinutes', 'travelBackMinutes', 'marginMinutes',
          'locationEntityId', 'createdAt', 'updatedAt', 'expiresAt'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'proposalId', 'logicalRequestId', 'accountScopeId',
          'state', 'title', 'humanPersonId', 'recurrenceType', 'days',
          'startTime', 'durationMinutes', 'anchorDateIso', 'weekOfMonth',
          'travelGoMinutes', 'travelBackMinutes', 'marginMinutes',
          'locationEntityId', 'createdAt', 'updatedAt', 'expiresAt'
        ])
        && data.schemaVersion == 1
        && data.proposalId == proposalId
        && data.proposalId is string
        && data.proposalId.size() == 64
        && data.accountScopeId == userId
        && data.logicalRequestId is string
        && data.logicalRequestId.size() > 0
        && data.logicalRequestId.size() <= 200
        && data.state in [
          'collecting', 'awaitingConfirmation', 'declined', 'committed',
          'cancelled'
        ]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.expiresAt is timestamp
        && data.expiresAt > data.createdAt
        && hasValidRoutineScalarFields(data)
        && (
          data.state == 'collecting'
          || hasCompleteRoutinePayload(data)
        );
    }

    function routineMatchesProposal(routine, proposal) {
      return routine.id == proposal.proposalId
        && routine.proposalId == proposal.proposalId
        && routine.accountScopeId == proposal.accountScopeId
        && routine.logicalRequestId == proposal.logicalRequestId
        && routine.title == proposal.title
        && routine.recurrenceType == proposal.recurrenceType
        && routine.days == proposal.days
        && routine.startTime == proposal.startTime
        && routine.durationMinutes == proposal.durationMinutes
        && routine.travelGoMinutes == proposal.travelGoMinutes
        && routine.travelBackMinutes == proposal.travelBackMinutes
        && routine.marginMinutes == proposal.marginMinutes
        && routine.schemaVersion == proposal.schemaVersion
        && routine.status == 'active'
        && routine.humanPersonId == proposal.humanPersonId
        && routine.locationEntityId == proposal.locationEntityId
        && routine.anchorDateIso == proposal.anchorDateIso
        && routine.weekOfMonth == proposal.weekOfMonth;
    }

    function routineProposalPath(userId, proposalId) {
      return /databases/$(database)/documents/users/$(userId)/routineProposals/$(proposalId);
    }

    function routinePath(userId, routineId) {
      return /databases/$(database)/documents/users/$(userId)/routines/$(routineId);
    }

    function hasValidRoutineOccurrenceOverrideShape(userId, overrideId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'schemaVersion', 'overrideId', 'accountScopeId', 'routineId',
          'sourceDateIso', 'type', 'replacementDateIso',
          'replacementStartTime', 'replacementEntityId', 'tombstone',
          'overrideRevision', 'lastMutationId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'schemaVersion', 'overrideId', 'accountScopeId', 'routineId',
          'sourceDateIso', 'type', 'replacementDateIso',
          'replacementStartTime', 'replacementEntityId', 'tombstone',
          'overrideRevision', 'lastMutationId', 'createdAt', 'updatedAt'
        ])
        && data.schemaVersion == 1
        && data.overrideId == overrideId
        && data.overrideId is string
        && data.overrideId.size() > 0
        && data.overrideId.size() <= 200
        && data.accountScopeId == userId
        && data.routineId is string
        && data.routineId.size() > 0
        && data.routineId.size() <= 200
        && isValidRoutineDate(data.sourceDateIso)
        && data.type in ['cancelled', 'moved', 'replaced']
        && data.tombstone is bool
        && data.overrideRevision is int
        && data.overrideRevision > 0
        && data.lastMutationId is string
        && data.lastMutationId.size() > 0
        && data.lastMutationId.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && data.createdAt <= request.time
        && data.updatedAt <= request.time
        && (
          (data.type == 'moved'
            && isValidRoutineDate(data.replacementDateIso)
            && isValidRoutineTime(data.replacementStartTime)
            && data.replacementEntityId == null)
          || (data.type == 'cancelled'
            && data.replacementDateIso == null
            && data.replacementStartTime == null
            && data.replacementEntityId == null)
          || (data.type == 'replaced'
            && data.replacementDateIso == null
            && data.replacementStartTime == null
            && (data.replacementEntityId == null
              || (data.replacementEntityId is string
                && data.replacementEntityId.size() > 0
                && data.replacementEntityId.size() <= 200)))
        );
    }

    function isValidRoutineOccurrenceOverrideCreate(userId, overrideId) {
      let data = request.resource.data;
      return hasValidRoutineOccurrenceOverrideShape(userId, overrideId)
        && data.overrideRevision == 1
        && !data.tombstone
        && data.createdAt == data.updatedAt
        && exists(routinePath(userId, data.routineId));
    }

    function isValidRoutineOccurrenceOverrideUpdate(userId, overrideId) {
      let next = request.resource.data;
      let previous = resource.data;
      return hasValidRoutineOccurrenceOverrideShape(userId, overrideId)
        && next.accountScopeId == previous.accountScopeId
        && next.overrideId == previous.overrideId
        && next.routineId == previous.routineId
        && next.sourceDateIso == previous.sourceDateIso
        && next.schemaVersion == previous.schemaVersion
        && next.createdAt == previous.createdAt
        && next.overrideRevision == previous.overrideRevision + 1
        && next.lastMutationId != previous.lastMutationId
        && next.updatedAt > previous.updatedAt
        && (!previous.tombstone || next.tombstone)
        && exists(routinePath(userId, next.routineId));
    }

    function canCreateRoutineFromProposal(userId, routineId, routine) {
      let proposal = get(
        routineProposalPath(userId, routineId)
      ).data;
      return proposal.state == 'awaitingConfirmation'
        && proposal.accountScopeId == userId
        && proposal.proposalId == routineId
        && request.time < proposal.expiresAt
        && routineMatchesProposal(routine, proposal);
    }

    function canCommitRoutineProposal(userId, proposalId, proposal) {
      let routine = getAfter(routinePath(userId, proposalId)).data;
      return request.time < proposal.expiresAt
        && routineMatchesProposal(routine, proposal);
    }

    function validRoutineProposalTransition(previous, next) {
      return
        (previous.state == 'collecting'
          && next.state in [
            'collecting', 'awaitingConfirmation', 'declined', 'cancelled'
          ])
        || (previous.state == 'awaitingConfirmation'
          && next.state in ['awaitingConfirmation', 'declined', 'committed',
            'cancelled']);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      match /conversations/{conversationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && hasValidConversationShape();
        allow delete: if isOwner(userId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && hasValidConversationMessageShape();
          allow update, delete: if false;
        }
      }

      match /memoryReplacementActions/{actionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasValidMemoryReplacementActionShape(actionId);
        allow update: if isOwner(userId)
          && hasValidMemoryReplacementActionShape(actionId)
          && request.resource.data.actionId == resource.data.actionId
          && request.resource.data.accountScopeFingerprint
            == resource.data.accountScopeFingerprint
          && request.resource.data.existingMemoryId
            == resource.data.existingMemoryId
          && request.resource.data.proposedMemoryId
            == resource.data.proposedMemoryId
          && request.resource.data.canonicalKey == resource.data.canonicalKey
          && request.resource.data.expectedExistingRevision
            == resource.data.expectedExistingRevision
          && request.resource.data.expectedProposedRevision
            == resource.data.expectedProposedRevision
          && request.resource.data.contradictionId
            == resource.data.contradictionId
          && request.resource.data.logicalRequestFingerprint
            == resource.data.logicalRequestFingerprint
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }

      match /identities/{entityId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidIdentityCreate(entityId);
        allow update: if isOwner(userId) && isValidIdentityUpdate(entityId);
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEventCreate(userId);
        allow update: if isOwner(userId) && isValidEventUpdate(userId);
        allow delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidRevisionedCreate(userId, taskId);
        allow update: if isOwner(userId)
          && isValidRevisionedUpdate(userId, taskId);
        allow delete: if false;
      }

      match /shopping_items/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidRevisionedCreate(userId, itemId);
        allow update: if isOwner(userId)
          && isValidRevisionedUpdate(userId, itemId);
        allow delete: if false;
      }

      match /actionLedger/{ledgerEntryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasValidActionLedger(userId, ledgerEntryId)
          && request.resource.data.ledgerRevision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId)
          && hasValidActionLedger(userId, ledgerEntryId)
          && request.resource.data.accountScopeId == resource.data.accountScopeId
          && request.resource.data.ledgerEntryId == resource.data.ledgerEntryId
          && request.resource.data.actionType == resource.data.actionType
          && request.resource.data.actionDomain == resource.data.actionDomain
          && request.resource.data.actionOrigin == resource.data.actionOrigin
          && request.resource.data.mutationId == resource.data.mutationId
          && request.resource.data.targetReference == resource.data.targetReference
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.ledgerRevision == resource.data.ledgerRevision + 1
          && request.resource.data.lastMutationId != resource.data.lastMutationId
          && validActionLedgerTransition(resource.data, request.resource.data)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /private/profile {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasValidRevisionedProfile(userId)
          && request.resource.data.profileRevision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId)
          && hasValidRevisionedProfile(userId)
          && (
            (
              resource.data.keys().hasAny(['profileRevision'])
              && request.resource.data.accountScopeId == resource.data.accountScopeId
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.profileRevision == resource.data.profileRevision + 1
              && request.resource.data.lastMutationId != resource.data.lastMutationId
            )
            || (
              !resource.data.keys().hasAny(['profileRevision'])
              && request.resource.data.profileRevision == 2
            )
          )
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /private/humanModel {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidHumanModelCreate(userId);
        allow update: if isOwner(userId)
          && isValidHumanModelUpdate(userId);
        allow delete: if false;
      }

      match /private/memoryPolicy {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasValidMemoryPolicyShape(userId)
          && request.resource.data.policyRevision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId)
          && hasValidMemoryPolicyShape(userId)
          && request.resource.data.accountScopeId == resource.data.accountScopeId
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.policyRevision == resource.data.policyRevision + 1
          && request.resource.data.lastMutationId != resource.data.lastMutationId
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /memories/{memoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidMemoryShape(userId, memoryId)
          && request.resource.data.memoryRevision == 1
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(userId)
          && isValidMemoryShape(userId, memoryId)
          && request.resource.data.accountScopeId == resource.data.accountScopeId
          && request.resource.data.memoryId == resource.data.memoryId
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.memoryRevision == resource.data.memoryRevision + 1
          && request.resource.data.lastMutationId != resource.data.lastMutationId
          && (!resource.data.tombstone || request.resource.data.tombstone)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /routines/{routineId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasValidRoutineShape(userId, routineId)
          && canCreateRoutineFromProposal(
            userId,
            routineId,
            request.resource.data
          );
        allow update: if false;
        allow delete: if false;
      }

      match /routineOccurrenceOverrides/{overrideId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidRoutineOccurrenceOverrideCreate(userId, overrideId);
        allow update: if isOwner(userId)
          && isValidRoutineOccurrenceOverrideUpdate(userId, overrideId);
        allow delete: if false;
      }

      match /routineProposals/{proposalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && hasValidRoutineProposalShape(userId, proposalId)
          && request.resource.data.state in [
            'collecting', 'awaitingConfirmation'
          ];
        allow update: if isOwner(userId)
          && hasValidRoutineProposalShape(userId, proposalId)
          && request.resource.data.accountScopeId == resource.data.accountScopeId
          && request.resource.data.proposalId == resource.data.proposalId
          && request.resource.data.logicalRequestId == resource.data.logicalRequestId
          && request.resource.data.schemaVersion == resource.data.schemaVersion
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.expiresAt == resource.data.expiresAt
          && (
            resource.data.state != 'awaitingConfirmation'
            || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['state', 'updatedAt'])
          )
          && validRoutineProposalTransition(
            resource.data,
            request.resource.data
          )
          && (
            request.resource.data.state != 'committed'
            || canCommitRoutineProposal(
              userId,
              proposalId,
              request.resource.data
            )
          );
        allow delete: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
